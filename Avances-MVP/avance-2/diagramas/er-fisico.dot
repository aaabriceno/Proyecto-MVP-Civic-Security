digraph ERF {
  rankdir=LR; nodesep=0.5; ranksep=1.3; fontname="Helvetica";
  node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [arrowhead=crow, arrowtail=tee, dir=both, color="#374151", style=dashed];

  incidentes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td colspan="3" bgcolor="#16A34A"><font color="white"><b>incidentes</b> — PostgreSQL 17 + PostGIS 3.5 (real)</font></td></tr>
    <tr><td bgcolor="#DCFCE7"><b>id</b></td><td bgcolor="#DCFCE7">uuid</td><td bgcolor="#DCFCE7">PRIMARY KEY</td></tr>
    <tr><td bgcolor="#DCFCE7">tipo</td><td bgcolor="#DCFCE7">varchar(255)</td><td bgcolor="#DCFCE7">NOT NULL</td></tr>
    <tr><td bgcolor="#DCFCE7">descripcion</td><td bgcolor="#DCFCE7">varchar(500)</td><td bgcolor="#DCFCE7">NULL</td></tr>
    <tr><td bgcolor="#DCFCE7">ubicacion</td><td bgcolor="#DCFCE7">geography(Point,4326)</td><td bgcolor="#DCFCE7">NOT NULL</td></tr>
    <tr><td bgcolor="#DCFCE7">estado</td><td bgcolor="#DCFCE7">varchar(255)</td><td bgcolor="#DCFCE7">NOT NULL DEFAULT 'sin_verificar'</td></tr>
    <tr><td bgcolor="#DCFCE7">idempotency_key</td><td bgcolor="#DCFCE7">uuid</td><td bgcolor="#DCFCE7">NOT NULL</td></tr>
    <tr><td bgcolor="#DCFCE7">inserted_at</td><td bgcolor="#DCFCE7">timestamp(6)</td><td bgcolor="#DCFCE7">NOT NULL</td></tr>
    <tr><td bgcolor="#DCFCE7">updated_at</td><td bgcolor="#DCFCE7">timestamp(6)</td><td bgcolor="#DCFCE7">NOT NULL</td></tr>
    <tr><td colspan="3" align="left"><b>Índices:</b></td></tr>
    <tr><td colspan="3" align="left">incidentes_pkey · btree (id)</td></tr>
    <tr><td colspan="3" align="left">incidentes_idempotency_key_index · UNIQUE btree (idempotency_key)</td></tr>
    <tr><td colspan="3" align="left">incidentes_inserted_at_index · btree (inserted_at)</td></tr>
    <tr><td colspan="3" align="left">incidentes_ubicacion_index · <b>GiST</b> (ubicacion)</td></tr></table>>];

  confirmaciones [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td colspan="3" bgcolor="#6B7280"><font color="white"><b>confirmaciones</b> (planificada)</font></td></tr>
    <tr><td bgcolor="#F3F4F6"><b>id</b></td><td bgcolor="#F3F4F6">uuid</td><td bgcolor="#F3F4F6">PK</td></tr>
    <tr><td bgcolor="#F3F4F6">incidente_id</td><td bgcolor="#F3F4F6">uuid</td><td bgcolor="#F3F4F6">FK → incidentes.id</td></tr>
    <tr><td bgcolor="#F3F4F6">valor</td><td bgcolor="#F3F4F6">varchar</td><td bgcolor="#F3F4F6">NOT NULL</td></tr>
    <tr><td bgcolor="#F3F4F6">voter_token</td><td bgcolor="#F3F4F6">bytea</td><td bgcolor="#F3F4F6">NOT NULL</td></tr>
    <tr><td colspan="3" align="left">UNIQUE (incidente_id, voter_token)</td></tr></table>>];

  evidencias [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td colspan="3" bgcolor="#6B7280"><font color="white"><b>evidencias</b> (planificada)</font></td></tr>
    <tr><td bgcolor="#F3F4F6"><b>id</b></td><td bgcolor="#F3F4F6">uuid</td><td bgcolor="#F3F4F6">PK</td></tr>
    <tr><td bgcolor="#F3F4F6">incidente_id</td><td bgcolor="#F3F4F6">uuid</td><td bgcolor="#F3F4F6">FK → incidentes.id</td></tr>
    <tr><td bgcolor="#F3F4F6">objeto_key</td><td bgcolor="#F3F4F6">text</td><td bgcolor="#F3F4F6">NOT NULL</td></tr></table>>];

  usuarios [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td colspan="3" bgcolor="#6B7280"><font color="white"><b>usuarios</b> (planificada)</font></td></tr>
    <tr><td bgcolor="#F3F4F6"><b>id</b></td><td bgcolor="#F3F4F6">uuid</td><td bgcolor="#F3F4F6">PK</td></tr>
    <tr><td bgcolor="#F3F4F6">alias</td><td bgcolor="#F3F4F6">varchar</td><td bgcolor="#F3F4F6">UNIQUE</td></tr>
    <tr><td bgcolor="#F3F4F6">password_hash</td><td bgcolor="#F3F4F6">text</td><td bgcolor="#F3F4F6">Argon2id</td></tr>
    <tr><td bgcolor="#F3F4F6">verif_hash</td><td bgcolor="#F3F4F6">bytea</td><td bgcolor="#F3F4F6">UNIQUE (HMAC DNI)</td></tr></table>>];

  zonas_alerta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td colspan="3" bgcolor="#6B7280"><font color="white"><b>zonas_alerta</b> (planificada)</font></td></tr>
    <tr><td bgcolor="#F3F4F6"><b>id</b></td><td bgcolor="#F3F4F6">uuid</td><td bgcolor="#F3F4F6">PK</td></tr>
    <tr><td bgcolor="#F3F4F6">usuario_id</td><td bgcolor="#F3F4F6">uuid</td><td bgcolor="#F3F4F6">FK → usuarios.id</td></tr>
    <tr><td bgcolor="#F3F4F6">celdas</td><td bgcolor="#F3F4F6">text[]</td><td bgcolor="#F3F4F6">índice GIN</td></tr>
    <tr><td bgcolor="#F3F4F6">centro_cifrado</td><td bgcolor="#F3F4F6">bytea</td><td bgcolor="#F3F4F6">AES-256-GCM</td></tr></table>>];

  incidentes -> confirmaciones; incidentes -> evidencias; usuarios -> zonas_alerta;
}
